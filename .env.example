NEXT_PUBLIC_SITE_URL=https://emeraldislemanpower.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Application email delivery (SMTP mailbox that sends candidate applications)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your@gmail.com,
# SMTP_PASSWORD=a 16-character App Password (Google Account > Security >
# 2-Step Verification > App Passwords — regular passwords do not work).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Comma-separated recruitment inboxes that receive applications with the CV
APPLICATIONS_EMAIL_TO=
# Optional friendly sender, e.g. "Emerald Isle Website <no-reply@emeraldisle.lk>"
APPLICATIONS_EMAIL_FROM=
