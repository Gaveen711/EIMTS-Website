{
  "name": "emerald-isle-manpower",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "dashboard",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:dashboard": "npm run dev --workspace=@eimts/dashboard",
    "build": "npm run build:web && npm run build:dashboard",
    "build:web": "next build",
    "build:dashboard": "npm run build --workspace=@eimts/dashboard",
    "start": "next start",
    "lint": "tsc --noEmit && npm run lint --workspace=@eimts/dashboard",
    "test": "npm run build",
    "deploy": "vercel --prod && vercel --prod --project eimts-website-dashboard"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "framer-motion": "^12.42.2",
    "leaflet": "^1.9.4",
    "next": "^16.2.12",
    "nodemailer": "^9.0.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-leaflet": "^5.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
